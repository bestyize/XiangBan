# Copy to the server as /your/deploy/path/.env and chmod 600.
# Do not commit the real .env file.
XIABAN_DOMAIN=xiaban.xyz

# Generate both values locally; do not reuse example strings.
DATABASE_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional integrations; leave blank to disable.
LLM_ENABLED=false
LLM_PRIMARY_NAME=
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_BACKUP_NAME=
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
LLM_DAILY_LIMIT=3
LLM_TIMEOUT_MS=3000

ADMIN_TOKEN=
# Used only to create the first administrator; after changing the password in /admin it is not reused.
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=123456
# Stable key for saved SMTP credentials. Preserve this key with database backups.
SETTINGS_ENCRYPTION_KEY=
QWEATHER_API_HOST=
QWEATHER_API_KEY=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=下班了么
SMTP_SSL=true

GO_HOME_ENABLED=false
APP_DOWNLOAD_URL=
