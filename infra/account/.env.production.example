# 复制到服务器的 $ACCOUNT_DEPLOY_PATH/.env 并 chmod 600。真实 .env 不要提交。
# 这个文件里的密钥一旦丢失无法重建，请和数据库备份一起离线保存。

# 数据库密码会拼进连接串，只用字母数字：openssl rand -hex 24
ACCOUNT_DB_PASSWORD=replace-with-hex-random-password

# 对外访问域名，必须带 https://，并且和 Nginx 的 server_name 一致。
# 它会写进每个令牌的 iss，业务服务验签时要用同一个值；上线后再改会让全部令牌失效。
ACCOUNT_ISSUER=https://account.xiangban.xyz

# 在服务器上执行下面的命令生成这两行，把输出粘贴到这里（镜像加载后即可运行）：
#   docker run --rm xiangban-account:latest gen-keys
# 不要用 openssl 生成签名私钥：它输出的 PKCS#8 格式服务读不了。
ACCOUNT_JWT_PKCS8_BASE64=
# 主密钥用来加密库里的邮箱/手机号并计算查找哈希，丢失后已有用户全部无法登录。
ACCOUNT_MASTER_KEY_BASE64=

# 初始管理员：只在数据库里还没有任何管理员时生效。登录 /admin/ 改完密码后，删除 PASSWORD 这一行。
ACCOUNT_ADMIN_USER=admin
ACCOUNT_ADMIN_PASSWORD=

# 验证码发送通道。默认 tencent；只想先联调页面时可临时设为 console（验证码只写进容器日志，勿对外开放）。
ACCOUNT_SENDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 手机号验证码：短信应用、已审核通过的签名与模板（模板两个参数：验证码、有效分钟数）
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 邮箱验证码：发信地址与模板（变量 code、minutes）
TENCENT_SES_FROM=
TENCENT_SES_TEMPLATE_ID=
TENCENT_SES_SUBJECT=相伴验证码
TENCENT_SES_REGION=ap-hongkong

# 可选。允许跨域调用账号中心的网页来源，逗号分隔；留空表示任意来源（令牌只走 Authorization 头）。
# ACCOUNT_CORS_ORIGINS=https://wallpaper.xiangban.xyz
# 可选。覆盖内置的应用登记列表，格式 id:名称,id2:名称2。登记后也可在后台增删。
# ACCOUNT_CLIENTS=
# 可选。验证码每日发送上限。
# ACCOUNT_DAILY_PER_IDENTIFIER=10
# ACCOUNT_DAILY_PER_IP=30

# 发布端口的地址，默认只给本机 Nginx 反代，不要改成 0.0.0.0。
# ACCOUNT_BIND_ADDRESS=127.0.0.1
