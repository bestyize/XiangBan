# 复制为服务器上的 .env（权限 600）。已有 .env 只按需补字段，不要用模板覆盖。
LINK_IMAGE_TAG=latest
# 用 openssl rand -hex 24 生成
LINK_DB_PASSWORD=
# 必须等于账号中心对外的 ACCOUNT_ISSUER
LINK_ACCOUNT_ISSUER=https://account.xiangban.xyz
LINK_ACCOUNT_JWKS_URL=https://account.xiangban.xyz/.well-known/jwks.json
LINK_ACCOUNT_CLIENT_IDS=xiaoban-desktop-wallpaper,xiaoban-android
