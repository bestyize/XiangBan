# 复制到服务器的 $FORUM_DEPLOY_PATH/.env 并 chmod 600。真实 .env 不要提交。

# 数据库密码会拼进连接串，只用字母数字：openssl rand -hex 24
FORUM_DB_PASSWORD=replace-with-hex-random-password

# 对外访问地址，用于 canonical 与 sitemap；要和 Nginx 的 server_name 一致。
# 先用 IP 联调可以设 http://43.142.93.110，上线域名后改回来。
FORUM_PUBLIC_URL=https://sh-chat.xiangban.xyz

# 统一账号中心： issuer 会写进令牌校验，必须和账号中心的 ACCOUNT_ISSUER 完全一致，不能改成代理路径。
# 复用香港线上账号中心时，注意该中心的 ACCOUNT_CORS_ORIGINS 要包含本论坛的 origin，否则浏览器登录被 CORS 拦截。
FORUM_ACCOUNT_ISSUER=https://account.xiangban.xyz
FORUM_ACCOUNT_CLIENT_ID=forum-web

# 初始管理员：只在数据库里还没有管理员时生效。登录 /admin 改密码后删除 PASSWORD 这一行。
FORUM_ADMIN_USER=admin
FORUM_ADMIN_PASSWORD=
# 管理员令牌签名密钥，至少 32 位：openssl rand -hex 24。不设置则每次重启随机生成，管理员需重新登录。
FORUM_ADMIN_JWT_SECRET=

# 可选。允许跨域调用论坛 API 的网页来源，逗号分隔；同域部署（前端由论坛自己托管）留空。
# FORUM_CORS_ORIGINS=

# 发布端口绑定地址，默认只给本机 Nginx 反代，不要改成 0.0.0.0。
# FORUM_BIND_ADDRESS=127.0.0.1

# 部署时由工作流写入镜像标签（提交 SHA 前 12 位）；手动 docker compose 时留空即 latest。
# FORUM_IMAGE_TAG=
