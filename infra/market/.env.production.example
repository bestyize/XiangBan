# 复制到服务器的部署目录并命名为 .env（权限 600），按需修改。
# 数据库密码只用字母数字：openssl rand -hex 24
MARKET_DB_PASSWORD=change-me
# 登录令牌签名密钥，上线后保持稳定，否则每次换值所有后台登录都会失效：openssl rand -hex 32
MARKET_JWT_SECRET=change-me-to-a-long-random-string

# 初始管理员（仅在库里还没有管理员时使用；首次登录后改密码并删掉 MARKET_ADMIN_PASS）
MARKET_ADMIN_USER=admin
MARKET_ADMIN_PASS=

# 相伴账号登录（可选）。issuer 必须等于账号中心的 ACCOUNT_ISSUER；账号中心要先登记应用 xiaoban-market。
# MARKET_ACCOUNT_ISSUER=https://account.xiangban.xyz
# MARKET_ACCOUNT_CLIENT_ID=xiaoban-market

# 镜像标签由部署工作流设置，手动回滚时在命令前加 MARKET_IMAGE_TAG=<旧标签>。
# MARKET_IMAGE_TAG=latest
# 不要改成 0.0.0.0：服务不带 TLS 和限流，只应通过宿主机 Nginx 对外。
# MARKET_BIND_ADDRESS=127.0.0.1
# 宿主机端口（容器内固定 55010）。香港服务器上 55010 已被论坛占用，所以默认 55011。
# MARKET_HOST_PORT=55011
