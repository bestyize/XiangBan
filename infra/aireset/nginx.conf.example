# 香港云服务器宿主机 Nginx 静态站点配置（HTTPS 终态）：aireset.xiaban.xyz
# 放进 /etc/nginx/conf.d/aireset.xiaban.xyz.conf
#
# 上线顺序（详见 infra/aireset/README.md）：
#   1. 先放置 nginx.http.conf.example（80 端口直接提供站点，并开放 certbot 校验目录）；
#   2. 在 DNSPod 为 aireset.xiaban.xyz 添加指向香港机公网 IP 的 A 记录并生效；
#   3. sudo certbot certonly --webroot -w /var/www/certbot -d aireset.xiaban.xyz
#   4. 改用本文件（80 跳转 443），sudo nginx -t && sudo systemctl reload nginx。

server {
    listen 80;
    listen [::]:80;
    server_name aireset.xiaban.xyz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name aireset.xiaban.xyz;

    ssl_certificate     /etc/letsencrypt/live/aireset.xiaban.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aireset.xiaban.xyz/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    root /var/www/aireset.xiaban.xyz;
    index index.html;
    error_page 404 /404.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 页面为内联 CSS/JS 的单文件，发版后需立即生效，不做强缓存。
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    location = /favicon.svg {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }
    location = /sitemap.xml {
        add_header Cache-Control "no-cache";
    }

    # 不做 SPA 全量回退：未知路径返回真实 404，避免被搜索引擎当作软 404 收录。
    location / {
        try_files $uri $uri/ =404;
    }
}
