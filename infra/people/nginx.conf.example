# 香港云服务器宿主机 Nginx 静态站点配置：people.xiaban.xyz
# 放进 /etc/nginx/conf.d/people.xiaban.xyz.conf
# 首次申请 HTTPS 证书前，可先注释掉 443 server 块，运行：
#   sudo certbot --nginx -d people.xiaban.xyz
# 证书签发后即可启用完整 HTTPS 配置并重载 Nginx。

server {
    listen 80;
    listen [::]:80;
    server_name people.xiaban.xyz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name people.xiaban.xyz;

    ssl_certificate     /etc/letsencrypt/live/people.xiaban.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/people.xiaban.xyz/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    root /var/www/people.xiaban.xyz;
    index index.html;

    # Gzip 压缩（全站静态产物 ~109 KB gzip）
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 基础安全头
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 带内容哈希的 JS/CSS 强缓存一年
    location /assets/ {
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html 禁止强缓存，确保每次发版用户秒看新版
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # SPA 回退（Hash 路由为主，兼容任意路径直访）
    location / {
        try_files $uri $uri/ /index.html;
    }
}
