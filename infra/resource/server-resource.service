[Unit]
Description=Xiaoban community resource service
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/xiangban-resource
EnvironmentFile=/home/ubuntu/xiangban-resource/.env
ExecStart=/home/ubuntu/xiangban-resource/server-resource
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/xiangban-resource/data
UMask=0077

[Install]
WantedBy=multi-user.target
