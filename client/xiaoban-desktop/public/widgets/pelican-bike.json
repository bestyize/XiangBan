{
  "schemaVersion": 1,
  "id": "pelican-bike",
  "name": "鹈鹕骑车",
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>鹈鹕骑行</title>\n<style>\n  html, body {\n    margin: 0; padding: 0; width: 300px; height: 260px;\n    overflow: hidden; background: transparent;\n    font-family: -apple-system, \"PingFang SC\", \"Microsoft YaHei\", \"Segoe UI\", sans-serif;\n  }\n  /* 不加整幅滤镜：每帧重绘 drop-shadow 太费，轮廓靠自身深色描边和地面阴影 */\n  #stage { display: block; width: 300px; height: 260px; }\n  .tag {\n    position: absolute; left: 24px; bottom: 14px;\n    display: flex; align-items: center; gap: 6px;\n    padding: 5px 11px 5px 9px;\n    background: #fff7ec; border-radius: 999px;\n    color: #2b2622; font-size: 11px; letter-spacing: .5px;\n    box-shadow: 0 1px 3px -2px rgba(0,0,0,.35);\n    user-select: none; pointer-events: none;\n  }\n  .tag b { font-weight: 600; }\n  .tag svg { display: block; }\n</style>\n</head>\n<body>\n<svg id=\"stage\" viewBox=\"0 0 300 260\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <linearGradient id=\"beakGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#f9a763\"/><stop offset=\"1\" stop-color=\"#dd7338\"/>\n    </linearGradient>\n  </defs>\n\n  <!-- 地面阴影 -->\n  <ellipse cx=\"146\" cy=\"214\" rx=\"84\" ry=\"6.5\" fill=\"rgba(43,38,34,.16)\"/>\n\n  <!-- 速度线 -->\n  <g stroke=\"#2b2622\" stroke-linecap=\"round\" opacity=\".16\" fill=\"none\">\n    <path d=\"M32 168 L58 168\" stroke-width=\"2.6\"/>\n    <path d=\"M22 183 L52 183\" stroke-width=\"2.6\"/>\n  </g>\n\n  <!-- 后轮 -->\n  <g>\n    <circle cx=\"84\" cy=\"176\" r=\"30\" fill=\"none\" stroke=\"#38332e\" stroke-width=\"6\"/>\n    <circle cx=\"84\" cy=\"176\" r=\"24.5\" fill=\"none\" stroke=\"#fff7ec\" stroke-width=\"2.4\" opacity=\".92\"/>\n    <g id=\"spokesBack\" stroke=\"#fff7ec\" stroke-width=\"1.5\" opacity=\".8\" stroke-linecap=\"round\">\n      <line x1=\"84\" y1=\"176\" x2=\"84\" y2=\"152\"/><line x1=\"84\" y1=\"176\" x2=\"105\" y2=\"164\"/>\n      <line x1=\"84\" y1=\"176\" x2=\"97\" y2=\"195\"/><line x1=\"84\" y1=\"176\" x2=\"71\" y2=\"195\"/>\n      <line x1=\"84\" y1=\"176\" x2=\"63\" y2=\"164\"/>\n    </g>\n    <circle cx=\"84\" cy=\"176\" r=\"3.6\" fill=\"#fff7ec\"/>\n  </g>\n\n  <!-- 前轮 -->\n  <g>\n    <circle cx=\"212\" cy=\"176\" r=\"30\" fill=\"none\" stroke=\"#38332e\" stroke-width=\"6\"/>\n    <circle cx=\"212\" cy=\"176\" r=\"24.5\" fill=\"none\" stroke=\"#fff7ec\" stroke-width=\"2.4\" opacity=\".92\"/>\n    <g id=\"spokesFront\" stroke=\"#fff7ec\" stroke-width=\"1.5\" opacity=\".8\" stroke-linecap=\"round\">\n      <line x1=\"212\" y1=\"176\" x2=\"212\" y2=\"152\"/><line x1=\"212\" y1=\"176\" x2=\"233\" y2=\"164\"/>\n      <line x1=\"212\" y1=\"176\" x2=\"225\" y2=\"195\"/><line x1=\"212\" y1=\"176\" x2=\"199\" y2=\"195\"/>\n      <line x1=\"212\" y1=\"176\" x2=\"191\" y2=\"164\"/>\n    </g>\n    <circle cx=\"212\" cy=\"176\" r=\"3.6\" fill=\"#fff7ec\"/>\n  </g>\n\n  <!-- 远侧腿 + 远侧踏板（在车架之后） -->\n  <path id=\"legB\" d=\"M144 114 L152 141 L130 168\" fill=\"none\" stroke=\"#c2632a\" stroke-width=\"4.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  <g id=\"crankB\">\n    <line id=\"crankBLine\" x1=\"146\" y1=\"170\" x2=\"130\" y2=\"170\" stroke=\"#2b2622\" stroke-width=\"3.4\" stroke-linecap=\"round\"/>\n    <rect id=\"pedalB\" x=\"122\" y=\"167.5\" width=\"15\" height=\"5\" rx=\"2.5\" fill=\"#2b2622\"/>\n  </g>\n  <g id=\"footB\"><path d=\"M-1 -3.6 C 6 -4.6 11 -2.6 13.5 -0.6 C 11.5 1.6 6 4.2 -1 3.4 Z\" fill=\"#c2632a\" stroke=\"#2b2622\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/></g>\n\n  <!-- 车架与车把：奶白衬底一圈，暗壁纸上也能看清轮廓 -->\n  <g fill=\"none\" stroke-linecap=\"round\">\n    <g stroke=\"#fff7ec\" stroke-width=\"7.8\" opacity=\".38\">\n      <path d=\"M84 176 L146 170\"/>\n      <path d=\"M84 176 L118 118\"/>\n      <path d=\"M146 170 L118 118\"/>\n      <path d=\"M118 118 L198 112\"/>\n      <path d=\"M146 170 L202 128\"/>\n      <path d=\"M198 112 L202 128\"/>\n      <path d=\"M202 128 L212 176\"/>\n      <path d=\"M198 112 L200 99\"/>\n      <path d=\"M200 99 L193 92\"/>\n    </g>\n    <g stroke=\"#3f6f68\" stroke-width=\"5.5\">\n      <path d=\"M84 176 L146 170\"/>\n      <path d=\"M84 176 L118 118\"/>\n      <path d=\"M146 170 L118 118\"/>\n      <path d=\"M118 118 L198 112\"/>\n      <path d=\"M146 170 L202 128\"/>\n      <path d=\"M198 112 L202 128\"/>\n      <path d=\"M202 128 L212 176\"/>\n      <path d=\"M198 112 L200 99\"/>\n      <path d=\"M200 99 L193 92\"/>\n    </g>\n  </g>\n  <!-- 握把 -->\n  <path d=\"M197 95 L189 90\" stroke=\"#2b2622\" stroke-width=\"6.5\" stroke-linecap=\"round\" fill=\"none\"/>\n  <!-- 车铃 -->\n  <g>\n    <circle cx=\"204\" cy=\"107\" r=\"3.4\" fill=\"#e8a33f\" stroke=\"#2b2622\" stroke-width=\"1.6\"/>\n    <path d=\"M204 103.6 L204 101.6\" stroke=\"#2b2622\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n  </g>\n  <!-- 车座 -->\n  <path d=\"M102 120 C 111 115 125 115 132 119 C 124 126 110 126 102 120 Z\" fill=\"#2b2622\"/>\n  <!-- 牙盘 -->\n  <circle cx=\"146\" cy=\"170\" r=\"9.5\" fill=\"rgba(255,247,236,.75)\" stroke=\"#3f6f68\" stroke-width=\"2.6\"/>\n  <circle cx=\"146\" cy=\"170\" r=\"2.4\" fill=\"#38332e\"/>\n\n  <!-- 近侧踏板（在车架之前） -->\n  <g id=\"crankA\">\n    <line id=\"crankALine\" x1=\"146\" y1=\"170\" x2=\"162\" y2=\"170\" stroke=\"#2b2622\" stroke-width=\"3.4\" stroke-linecap=\"round\"/>\n    <rect id=\"pedalA\" x=\"154\" y=\"167.5\" width=\"16\" height=\"5\" rx=\"2.5\" fill=\"#2b2622\"/>\n  </g>\n  <!-- 近侧腿（最前） -->\n  <path id=\"legA\" d=\"M150 114 L160 141 L162 168\" fill=\"none\" stroke=\"#e8823f\" stroke-width=\"4.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  <g id=\"footA\"><path d=\"M-1 -3.9 C 6 -5 12 -2.8 14.5 -0.5 C 12.4 1.8 6 4.6 -1 3.7 Z\" fill=\"#e8823f\" stroke=\"#2b2622\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/></g>\n\n  <!-- 鹈鹕 -->\n  <g id=\"rider\">\n    <!-- 尾羽 -->\n    <path d=\"M106 104 C 93 106 82 113 75 121 C 89 122 100 117 109 112 Z\" fill=\"#efe2d1\" stroke=\"#2b2622\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n    <!-- 脖子 -->\n    <path d=\"M160 88 C 168 74 174 60 184 50\" fill=\"none\" stroke=\"#2b2622\" stroke-width=\"25\" stroke-linecap=\"round\"/>\n    <path d=\"M160 88 C 168 74 174 60 184 50\" fill=\"none\" stroke=\"#fff7ec\" stroke-width=\"21\" stroke-linecap=\"round\"/>\n    <!-- 身体 -->\n    <ellipse cx=\"136\" cy=\"100\" rx=\"37\" ry=\"28\" transform=\"rotate(-8 136 100)\" fill=\"#fff7ec\" stroke=\"#2b2622\" stroke-width=\"2.4\"/>\n    <path d=\"M104 112 C 118 122 150 124 168 112\" fill=\"none\" stroke=\"#e9dbc8\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\".9\"/>\n    <!-- 头 -->\n    <circle cx=\"188\" cy=\"46\" r=\"15.5\" fill=\"#fff7ec\" stroke=\"#2b2622\" stroke-width=\"2.4\"/>\n    <!-- 喉囊：贴着下喙，浅浅地垂下来 -->\n    <path d=\"M197 48 C 205 64 218 74 231 71 C 242 68 249 63 250 58 C 234 57 210 53 197 48 Z\" fill=\"url(#beakGrad)\" stroke=\"#2b2622\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n    <!-- 上喙：细长，尖端带小钩 -->\n    <path d=\"M196 40 C 216 42 238 50 250 56 C 253 58 252 62 248 61 C 235 59 211 53 195 48 Z\" fill=\"url(#beakGrad)\" stroke=\"#2b2622\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n    <!-- 喙缝 + 鼻孔 -->\n    <path d=\"M201 49 C 215 53 233 57 247 60\" fill=\"none\" stroke=\"#2b2622\" stroke-width=\"1.4\" stroke-linecap=\"round\" opacity=\".3\"/>\n    <circle cx=\"206\" cy=\"45.6\" r=\"1.2\" fill=\"#2b2622\" opacity=\".45\"/>\n    <!-- 眼睛 -->\n    <circle cx=\"192\" cy=\"40\" r=\"3\" fill=\"#2b2622\"/>\n    <circle cx=\"193.2\" cy=\"38.9\" r=\"1\" fill=\"#fff7ec\"/>\n    <!-- 翅膀（前伸，搭在车把上） -->\n    <path d=\"M139 83 C 154 79 170 85 182 90 C 188 93 192 93 195 91 C 195 98 186 100 176 96 C 162 91 147 89 139 83 Z\" fill=\"#f3e6d5\" stroke=\"#2b2622\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/>\n    <path d=\"M149 87 C 160 90 172 94 184 97\" fill=\"none\" stroke=\"#d9c6ad\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n  </g>\n</svg>\n\n<div class=\"tag\">\n  <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b2622\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"5.5\" cy=\"17.5\" r=\"3.5\"/><circle cx=\"18.5\" cy=\"17.5\" r=\"3.5\"/>\n    <path d=\"M15 17.5h-6M9 17.5 6.5 8H4M9 8h7l2.5 9.5\"/>\n  </svg>\n  <span><b>慢慢骑</b>，也会到</span>\n</div>\n\n<script>\n(function () {\n  'use strict';\n  var back = document.getElementById('spokesBack');\n  var front = document.getElementById('spokesFront');\n  var crankALine = document.getElementById('crankALine');\n  var pedalA = document.getElementById('pedalA');\n  var crankBLine = document.getElementById('crankBLine');\n  var pedalB = document.getElementById('pedalB');\n  var legA = document.getElementById('legA');\n  var legB = document.getElementById('legB');\n  var footA = document.getElementById('footA');\n  var footB = document.getElementById('footB');\n\n  var BB = { x: 146, y: 170 }, R = 16;\n  var wheelAng = 0, crankAng = 0, last = 0, raf = null;\n\n  function place(el, x, y) {\n    el.setAttribute('x', (x - 8).toFixed(1));\n    el.setAttribute('y', (y - 2.5).toFixed(1));\n  }\n  function line(el, x2, y2) {\n    el.setAttribute('x2', x2.toFixed(1));\n    el.setAttribute('y2', y2.toFixed(1));\n  }\n  // 两段式腿：髋 -> 膝 -> 踏板，膝盖始终朝前\n  function legPath(x1, y1, kneeX, kneeY, x2, y2) {\n    return 'M' + x1 + ' ' + y1 + ' L' + kneeX + ' ' + kneeY +\n           ' L' + x2.toFixed(1) + ' ' + y2.toFixed(1);\n  }\n\n  function draw(a) {\n    var ca = Math.cos(a), sa = Math.sin(a);\n    var ax = BB.x + R * ca, ay = BB.y + R * sa;\n    var bx = BB.x - R * ca, by = BB.y - R * sa;\n\n    line(crankALine, ax, ay); line(crankBLine, bx, by);\n    place(pedalA, ax, ay);   place(pedalB, bx, by);\n    legA.setAttribute('d', legPath(150, 114, 160, 141, ax, ay - 4));\n    legB.setAttribute('d', legPath(144, 114, 152, 141, bx, by - 4));\n    // 蹼足踩在踏板上\n    footA.setAttribute('transform', 'translate(' + (ax - 1).toFixed(1) + ',' + (ay - 4).toFixed(1) + ')');\n    footB.setAttribute('transform', 'translate(' + (bx - 1).toFixed(1) + ',' + (by - 4).toFixed(1) + ')');\n  }\n\n  function frame(ts) {\n    if (!last) last = ts;\n    var dt = Math.min(ts - last, 60) / 1000;\n    last = ts;\n    wheelAng = (wheelAng + dt * 110) % 360;\n    crankAng += dt * 1.6;\n\n    back.setAttribute('transform', 'rotate(' + wheelAng.toFixed(1) + ' 84 176)');\n    front.setAttribute('transform', 'rotate(' + wheelAng.toFixed(1) + ' 212 176)');\n    draw(crankAng);\n    raf = requestAnimationFrame(frame);\n  }\n\n  function start() { if (raf === null) { last = 0; raf = requestAnimationFrame(frame); } }\n  function stop() { if (raf !== null) { cancelAnimationFrame(raf); raf = null; } }\n\n  document.addEventListener('visibilitychange', function () {\n    if (document.hidden) stop(); else start();\n  });\n\n  draw(0);\n  if (!document.hidden) start();\n})();\n</script>\n</body>\n</html>",
  "theme": "transparent",
  "description": "一只戴围巾的鹈鹕踩着自行车，轮子和踏板轻缓转动，配一句\"慢慢骑，也会到\"。",
  "width": 300.0,
  "height": 260.0
}