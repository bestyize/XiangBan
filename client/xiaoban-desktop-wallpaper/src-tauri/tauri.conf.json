{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小伴",
  "version": "0.1.0",
  "identifier": "xyz.xiaban.desktop-wallpaper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "control", "title": "小伴 · 桌面陪伴", "width": 940, "height": 740,
      "minWidth": 820, "minHeight": 640, "center": true, "backgroundColor": "#111820"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
