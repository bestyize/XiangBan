{
  "name": "xiaoban-desktop-wallpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/check-builtin-assets.mjs && tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:macos:build": "tauri build --target aarch64-apple-darwin --bundles app",
    "test:macos": "node scripts/smoke-test.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
