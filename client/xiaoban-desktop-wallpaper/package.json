{
  "name": "xiaoban-desktop-wallpaper",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "computer-use:prepare": "node ../../libs/agent-tools/computer-use/scripts/prepare-runtime.mjs --output src-tauri/resources/computer-use",
    "test:computer-use": "node --test ../../libs/agent-tools/computer-use/scripts/prepare-runtime.test.mjs ../../.github/signing/identity.test.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/check-builtin-assets.mjs && node scripts/check-game-assets.mjs && vue-tsc --noEmit && vite build",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --no-bundle",
    "desktop:macos:build": "node scripts/desktop.mjs build --target aarch64-apple-darwin --bundles app",
    "test:macos": "node scripts/smoke-test.mjs",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test scripts/generate-icon.test.mjs",
    "desktop:windows:build": "tauri build --bundles nsis",
    "test:windows:installer": "node scripts/verify-windows-installer.mjs",
    "test:macos:dmg": "node scripts/verify-macos-dmg-guide.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.14.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "dependencies": {
    "lucide-vue-next": "0.577.0",
    "naive-ui": "2.45.3",
    "vue": "3.5.43"
  }
}
