# ============================================================
# WallpaperCollect Configuration
# ============================================================

# Server Listen Address and Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# PostgreSQL Database Connection String
# Needed for: the admin console (/admin), several API keys per provider, the proxy pool,
# the persistent search cache, and saving wallpapers and favorites.
# Without it the service still runs in memory mode, using the keys below, with no admin console and no cache.
# DATABASE_URL=postgres://postgres:password123@localhost:5432/wallpaper_collect

# Provider API keys (Optional)
# With a database, these are copied into the admin console the first time the service starts.
# After that, add, remove and rotate keys in the console (/admin); changing these values has no effect.
# Without a database, these are the only keys in use.

# Unsplash Official API Access Key. Get your free key at: https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pixabay Official API Key (photos and 4K live video wallpapers). Get your free key at: https://pixabay.com/api/docs/
# PIXABAY_API_KEY=your_pixabay_api_key_here

# Pexels Official API Key (photos and HD/4K video wallpapers). Get your free key at: https://www.pexels.com/api/
# PEXELS_API_KEY=your_pexels_api_key_here

# okslop API key (AI-generated images, free for commercial use). Get one at: https://okslop.com/developers
# OKSLOP_API_KEY=your_okslop_api_key_here

# Bing Daily Wallpaper (public archive requires no key by default; optional)
# BING_API_KEY=optional_bing_api_key_here

# Enable built-in curated 4K and live video demo wallpapers (default: true)
ENABLE_DEMO_DATA=true

# Initial lifetime of cached search results, in seconds (default: 3600).
# Used only until it is first saved in the admin console, which then takes over.
CACHE_TTL_SECS=3600

# Background Wallpaper Collector Interval in minutes (0 to disable, default: 60)
AUTO_SYNC_INTERVAL_MINS=60


# SkillHub 团队接入 Key：仅用于服务端 AI 插件目录代理，不填时尝试公开接口。
# 正式产品接入前按 SkillHub 官方说明确认配额与使用范围。
SKILLHUB_API_KEY=
