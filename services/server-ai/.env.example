AI_DATABASE_URL=postgres://xiaban@localhost:5432/xiaban_ai
AI_HOST=127.0.0.1
AI_PORT=55010
AI_DATA_DIR=ai_data

# 账号中心：用它的 JWKS 离线验签，iss 必须与账号中心的 ACCOUNT_ISSUER 一致
AI_ACCOUNT_ISSUER=https://account.xiangban.xyz
# AI_ACCOUNT_JWKS_URL=https://account.xiangban.xyz/.well-known/jwks.json

# New API 网关（只监听回环地址）。管理令牌必须是只含 user:read、user:write 作用域的访问令牌，不要用 root
AI_NEWAPI_BASE_URL=http://127.0.0.1:3000
# New API 管理令牌一般不写在这里：启动后登录后台「网关连接」页填写即可（加密存数据库，优先于这里）。
# 只在需要无人值守地初始化时才设置：
# AI_NEWAPI_ADMIN_TOKEN=
# 未配置倍率的模型在 New API 里使用的默认倍率，保存档位时用它判断是否漏配
# AI_NEWAPI_DEFAULT_RATIO=37.5
# New API 里 1 美元对应的额度点数，仅用于后台展示
# AI_QUOTA_PER_UNIT=500000

# 主密钥（至少 32 字节，base64）：加密保存各绑定的 New API Key，并派生管理员令牌密钥。必须备份。
# 生成：cargo run --manifest-path services/server-ai/Cargo.toml -- gen-key
# AI_MASTER_KEY_BASE64=

# 仅在数据库里还没有管理员时用来创建初始管理员；登录后台改密码后请删除 PASSWORD 这一行
# AI_ADMIN_USER=admin
# AI_ADMIN_PASSWORD=

# 管理后台前端构建产物目录（相对启动目录）；容器里用绝对路径
# AI_WEB_DIR=services/server-ai/web/dist

# 位于 Nginx 之后且 Nginx 设置了 X-Real-IP 时才开启
# AI_TRUST_PROXY=true
# AI_CORS_ORIGINS=https://wallpaper.xiangban.xyz

# 语音合成、图片生成、语音识别、实时语音用哪个模型，在管理后台「产品与档位 → 媒体能力」里按产品设置，不再用环境变量。

# 联网搜索 /v1/search 与网页抓取 /v1/fetch：按顺序尝试的服务商，没配密钥的跳过；都没有时接口返回 503 search_unavailable
# newapi：经 New API 的 deepseek-search / deepseek-fetch 模型转发并由它计费；deepseek：直连，由本服务扣点
# AI_SEARCH_PROVIDERS=newapi,deepseek
# 可以填多个密钥，逗号分隔：请求轮流使用，某个失效或限流时自动换下一个
# AI_DEEPSEEK_API_KEY=sk-aaa,sk-bbb
# AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 走直连服务商时，每次有结果的搜索 / 每次成功的抓取扣多少 New API 额度点数（AI_QUOTA_PER_UNIT 点 = 1 美元）
# AI_SEARCH_COST=500
# AI_FETCH_COST=500
