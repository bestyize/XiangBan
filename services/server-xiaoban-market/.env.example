# ============================================================
# 小伴市场 server-xiaoban-market
# ============================================================
MARKET_HOST=0.0.0.0
MARKET_PORT=55010

# PostgreSQL（需要 pg_trgm 扩展；该扩展是 trusted extension，库的所有者即可创建）
DATABASE_URL=postgres://market:change-me@127.0.0.1:5432/xiaoban_market

# 登录令牌签名密钥。生产环境必须设置且保持稳定，否则每次重启所有后台登录都会失效。
MARKET_JWT_SECRET=

# 首次启动创建的管理员。不设置 MARKET_ADMIN_PASS 时会随机生成并只在日志里显示一次。
MARKET_ADMIN_USER=admin
MARKET_ADMIN_PASS=

# 安装包存放目录（按内容哈希寻址，需要持久化和备份）
MARKET_DATA_DIR=./data

# 前端构建产物目录；不存在时只提供 API
MARKET_WEB_DIR=services/server-xiaoban-market/web/dist

# 仅用于本机联调：允许采集器访问回环 / 内网地址。生产环境不要开启。
# MARKET_ALLOW_PRIVATE_UPSTREAM=true
