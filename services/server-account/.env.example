ACCOUNT_DATABASE_URL=postgres://xiaban@localhost:5432/xiaban_account
ACCOUNT_PORT=55009
ACCOUNT_ISSUER=https://account.xiangban.xyz
ACCOUNT_DATA_DIR=account_data

# 仅在数据库还没有管理员时用于创建初始管理员；登录后台改密码后请删除 PASSWORD 这一行
# ACCOUNT_ADMIN_USER=admin
# ACCOUNT_ADMIN_PASSWORD=
# 管理后台前端构建产物目录（相对启动目录）；容器里用绝对路径
# ACCOUNT_WEB_DIR=services/server-account/web/dist

# console 仅开发使用；生产配置腾讯云或在后台保存 SMTP 邮件通道，手机号可独立配置 PNVS
ACCOUNT_SENDER=console

# ACCOUNT_SENDER=tencent 时填写
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SES_FROM=
# TENCENT_SES_TEMPLATE_ID=

# 独立手机号通道，可与后台配置的 SMTP 邮件并用；留空时沿用 ACCOUNT_SENDER。
# 个人账号在阿里云「号码认证 > 短信认证」开通，签名填写控制台的系统赠送签名。
# ACCOUNT_SMS_PROVIDER=aliyun_pnvs
# ALIYUN_PNVS_ACCESS_KEY_ID=
# ALIYUN_PNVS_ACCESS_KEY_SECRET=
# ALIYUN_PNVS_SIGN_NAME=
# ALIYUN_PNVS_SCHEME_NAME=
# 配置重启后，后台「发信设置 > 新用户注册方式」勾选手机号注册，默认关闭。

# 位于 Nginx 之后且 Nginx 设置了 X-Real-IP 时才开启
# ACCOUNT_TRUST_PROXY=true
# ACCOUNT_CORS_ORIGINS=https://wallpaper.xiangban.xyz


# 允许论坛后台创建编辑账号：与 FORUM_ACCOUNT_PROVISION_KEY 设置相同的随机值（至少32字节）。
# 仅授予创建普通用户的能力，不使用管理员密码；不配置时该通道关闭。
ACCOUNT_FORUM_PROVISION_KEY=
