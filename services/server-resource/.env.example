# 监听地址；对外由 Nginx 反代（关闭请求缓冲，client_max_body_size ≥ 40m）。
# RESOURCE_HOST=127.0.0.1
# RESOURCE_PORT=55020

# 文件根目录，需要持久化和异地备份。
# RESOURCE_DATA_DIR=services/server-resource/data

# 与 server-forum 的 FORUM_RESOURCE_SECRET 相同（至少 32 位），必填。
RESOURCE_SECRET=

# 上传完成后回调论坛的地址。
# RESOURCE_CALLBACK_URL=https://chat.xiangban.xyz/api/internal/pack-uploaded

# 允许从这些网页源直传（逗号分隔）；为空表示任意来源（凭证本身已是授权）。
# RESOURCE_CORS_ORIGINS=https://chat.xiangban.xyz

# 同时进行的上传数，防止把 200 Mbps 和磁盘写满。
# RESOURCE_MAX_UPLOADS=8
