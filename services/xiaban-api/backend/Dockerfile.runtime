# Runtime-only image for previews whose installDist output was built on the host.
FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 --no-create-home xiaban
WORKDIR /app
COPY services/xiaban-api/backend/build/install/backend /app
RUN chmod +x /app/bin/backend
USER xiaban
ENV JAVA_OPTS="-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError" \
    XIABAN_ENV=prod \
    PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/bin/backend"]
