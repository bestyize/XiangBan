FORUM_DATABASE_URL=postgres://xiaban@localhost:5432/xiaban_forum
FORUM_HOST=127.0.0.1
FORUM_PORT=55010
# 对外地址，用于 canonical、sitemap
FORUM_PUBLIC_URL=https://chat.xiangban.xyz

# 统一账号中心：签发者即账号中心地址；本站在账号中心登记的应用 ID
FORUM_ACCOUNT_ISSUER=https://account.xiangban.xyz
FORUM_ACCOUNT_CLIENT_ID=forum-web
# 除网页外也接受的令牌受众（小伴手机应用），逗号分隔；不设置时默认就是 xiaoban-android
# FORUM_ACCOUNT_EXTRA_CLIENT_IDS=xiaoban-android
# FORUM_ACCOUNT_JWKS_URL=https://account.xiangban.xyz/.well-known/jwks.json

# 管理后台：没有管理员时用下面两行创建初始管理员，登录后台改密码后删掉 PASSWORD
# FORUM_ADMIN_USER=admin
# FORUM_ADMIN_PASSWORD=
# 至少 32 位随机字符串；不设置则每次重启随机生成，管理员需要重新登录
FORUM_ADMIN_JWT_SECRET=

# 前端构建产物目录（相对启动目录）
# FORUM_WEB_DIR=services/server-forum/web/dist
# 只有浏览器跨域调用时才需要；同域部署可留空
# FORUM_CORS_ORIGINS=

# 信任等级门槛（TL0 → TL1）与每日上限（按等级 0,1,2,3）
# FORUM_TL1_DAYS=3
# FORUM_TL1_READS=30
# FORUM_DAILY_TOPICS=2,5,20,50
# FORUM_DAILY_POSTS=10,60,200,500

# 帖子附件：存放目录，以及单个文件的大小上限（MB）。普通用户和守护者（站务人员）分开设置。
# 反向代理的 client_max_body_size 需要不小于守护者上限。
# FORUM_UPLOAD_DIR=services/server-forum/data/uploads
# FORUM_UPLOAD_MAX_MB_USER=5
# FORUM_UPLOAD_MAX_MB_ADMIN=30
# 正文插图的大小上限（MB），所有人一样
# FORUM_UPLOAD_MAX_MB_IMAGE=5

# 资源机（大文件、封面、内容包）的对外地址与共用签名密钥（至少 32 位，两台机器一致）。
# FORUM_RESOURCE_BASE_URL=https://res.xiangban.xyz
# FORUM_RESOURCE_SECRET=
# FORUM_DOWNLOAD_URL_TTL_SECS=600
# FORUM_UPLOAD_TICKET_TTL_SECS=1800
# FORUM_DAILY_PACK_PUBLISHES=5


# 与账号中心 ACCOUNT_FORUM_PROVISION_KEY 相同的随机值（至少32字节）。
# 不配置时仍可绑定已有论坛用户，不能从论坛后台创建新账号。
FORUM_ACCOUNT_PROVISION_KEY=
